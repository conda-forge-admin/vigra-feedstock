From f2755c90551b4af0ed2ed517ef64abcffd91b3c1 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Tue, 23 Dec 2025 07:55:12 -0500
Subject: [PATCH] Conditionally remove numpy's ptp methods if numpy 2.4 or
 grater is detected

Closes https://github.com/ukoethe/vigra/issues/613
---
 docsrc/credits_changelog.dxx       |  8 +++++++
 vigranumpy/lib/arraytypes.py       | 35 ++++++++++++++++--------------
 vigranumpy/lib/axistags.py         | 12 +++++-----
 vigranumpy/lib/tagged_array.py     | 17 +++++++++------
 vigranumpy/test/test_arraytypes.py | 10 ++++-----
 5 files changed, 49 insertions(+), 33 deletions(-)

diff --git a/docsrc/credits_changelog.dxx b/docsrc/credits_changelog.dxx
index ca5c5f491..b75ab610a 100644
--- a/docsrc/credits_changelog.dxx
+++ b/docsrc/credits_changelog.dxx
@@ -87,6 +87,14 @@
 Many thanks to all!
 <p>
 
+<b> Changes from Version 1.12.2 to 1.12.3 (2025/03/13)</b>
+
+<ul>
+
+      <li> Vigra Numpy: fix compatibility with numpy 2.4. The methods ptp of the Vigra arrays are conditionally removed if numpy 2.4 or greater is detected.
+
+</ul>
+
 <b> Changes from Version 1.12.1 to 1.12.2 (2025/03/13)</b>
 
 <ul>
diff --git a/vigranumpy/lib/arraytypes.py b/vigranumpy/lib/arraytypes.py
index 52b2623ed..d9e24f4bc 100644
--- a/vigranumpy/lib/arraytypes.py
+++ b/vigranumpy/lib/arraytypes.py
@@ -37,6 +37,7 @@
 import sys
 import copy
 import numpy
+
 from . import ufunc
 import vigra.vigranumpycore as vigranumpycore
 
@@ -44,6 +45,7 @@
 
 from collections.abc import Iterable
 
+numpyHasPtp = np.__version__.startswith(("1.", "2.0.", "2.1.", "2.2.", "2.3."))
 
 def _preserve_doc(f):
     npy_doc = eval('numpy.ndarray.%s.__doc__' % f.__name__)
@@ -1435,22 +1437,23 @@ def prod(self, axis=None, dtype=None, out=None):
         '''
         return _numpyarray_overloaded_function(numpy.ndarray.prod, self, axis, dtype, out)
 
-    @_preserve_doc
-    def ptp(self, axis=None, out=None):
-        '''
-        The 'axis' parameter can be an int (axis position) or string (axis key).
-        '''
-        if type(axis) == str:
-            axis = self.axistags.index(axis)
-        if axis is None:
-            return numpy.ptp(self.transposeToOrder('C').view(numpy.ndarray), out=out)
-        else:
-            res = numpy.ptp(self.view(numpy.ndarray), axis=axis, out=out)
-            if out is None:
-                res = res.view(VigraArray)
-                res.axistags = self._copy_axistags()
-                del res.axistags[axis]
-            return res
+    if numpyHasPtp:
+        @_preserve_doc
+        def ptp(self, axis=None, out=None):
+            '''
+            The 'axis' parameter can be an int (axis position) or string (axis key).
+            '''
+            if type(axis) == str:
+                axis = self.axistags.index(axis)
+            if axis is None:
+                return numpy.ptp(self.transposeToOrder('C').view(numpy.ndarray), out=out)
+            else:
+                res = numpy.ptp(self.view(numpy.ndarray), axis=axis, out=out)
+                if out is None:
+                    res = res.view(VigraArray)
+                    res.axistags = self._copy_axistags()
+                    del res.axistags[axis]
+                return res
 
     @_preserve_doc
     def ravel(self, order='C'):
diff --git a/vigranumpy/lib/axistags.py b/vigranumpy/lib/axistags.py
index 4f8986858..c1f81ace8 100644
--- a/vigranumpy/lib/axistags.py
+++ b/vigranumpy/lib/axistags.py
@@ -1,4 +1,5 @@
 import numpy as np
+numpyHasPtp = np.__version__.startswith(("1.", "2.0.", "2.1.", "2.2.", "2.3."))
 
 
 class TaggedArray(np.ndarray):
@@ -88,11 +89,12 @@ def prod(self, axis=None, dtype=None, out=None):
             del res.axistags[axis]
         return res
 
-    def ptp(self, axis=None, out=None):
-        res = np.ndarray.ptp(self, axis, out)
-        if axis is not None:
-            del res.axistags[axis]
-        return res
+    if numpyHasPtp:
+        def ptp(self, axis=None, out=None):
+            res = np.ndarray.ptp(self, axis, out)
+            if axis is not None:
+                del res.axistags[axis]
+            return res
 
     def ravel(self, order='C'):
         res = np.ndarray.ravel(self, order)
diff --git a/vigranumpy/lib/tagged_array.py b/vigranumpy/lib/tagged_array.py
index efc63ca13..0b4117139 100644
--- a/vigranumpy/lib/tagged_array.py
+++ b/vigranumpy/lib/tagged_array.py
@@ -36,6 +36,8 @@
 import copy, sys
 import numpy
 
+numpyHasPtp = np.__version__.startswith(("1.", "2.0.", "2.1.", "2.2.", "2.3."))
+
 
 def preserve_doc(f):
     f.__doc__ = eval('numpy.ndarray.%s.__doc__' % f.__name__)
@@ -263,13 +265,14 @@ def prod(self, axis=None, dtype=None, out=None):
             del res.axistags[axis]
         return res
 
-    @preserve_doc
-    def ptp(self, axis=None, out=None):
-        res = numpy.ndarray.ptp(self, axis, out)
-        if axis is not None:
-            res.axistags = res.copy_axistags()
-            del res.axistags[axis]
-        return res
+    if numpyHasPtp:
+        @preserve_doc
+        def ptp(self, axis=None, out=None):
+            res = numpy.ndarray.ptp(self, axis, out)
+            if axis is not None:
+                res.axistags = res.copy_axistags()
+                del res.axistags[axis]
+            return res
 
     @preserve_doc
     def ravel(self, order='C'):
diff --git a/vigranumpy/test/test_arraytypes.py b/vigranumpy/test/test_arraytypes.py
index 7111196ef..6f7b5c58f 100644
--- a/vigranumpy/test/test_arraytypes.py
+++ b/vigranumpy/test/test_arraytypes.py
@@ -51,7 +51,7 @@
 IS_PYPY = platform.python_implementation() == 'PyPy'
 
 
-numpyHasComplexNegateBug = numpy.version.version.startswith('1.0')
+numpyHasPtp = np.__version__.startswith(("1.", "2.0.", "2.1.", "2.2.", "2.3."))
 
 try:
     vt.testAny()
@@ -1471,8 +1471,9 @@ def testMethods():
     assert_equal(ones.prod(), 1.0)
     assert (ones.prod(axis='y') == [1]*ones.shape[0]).all()
 
-    assert_equal(a.ptp(), a.size-1)
-    assert (a.ptp(axis='x') == [a.shape[0]-1]*a.shape[1]).all()
+    if numpyHasPtp:
+        assert_equal(a.ptp(), a.size-1)
+        assert (a.ptp(axis='x') == [a.shape[0]-1]*a.shape[1]).all()
 
     r = arraytypes.ScalarImage((2,2))
     r.ravel()[...] = range(4)
@@ -1555,8 +1556,7 @@ def testUfuncs():
         b = -a
         assert_equal(t, b.dtype)
         assert_equal(a.axistags, b.axistags)
-        if not numpyHasComplexNegateBug or t is not clongdouble:
-            assert (b == -t(2)).all()
+        assert (b == -t(2)).all()
         b = a + a
         assert_equal(t, b.dtype)
         assert_equal(a.axistags, b.axistags)
